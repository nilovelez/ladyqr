# LadyQR: the fixed rules for Apache.
#
# Every directive here is wrapped or chosen so that, on a host that does not
# allow it, the site keeps working instead of answering with an error.

DirectoryIndex index.php index.html

# Do not list the contents of folders. Each folder has a blank index.html, so a
# visitor gets an empty page, and this hides the entries if one is ever missing.
<IfModule mod_autoindex.c>
IndexIgnore *
</IfModule>

# The configuration file, and anything named after it (backups, copies), is only
# ever read by PHP, never served.
# Apache 2.4 and 2.2 use different syntax, so both are given.
<FilesMatch "^ladyqr-config">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>

# Anything that does not exist, and is not a short link, gets the not-found page,
# which answers with a real 404 status. The path starts at the web root of the
# domain: if LadyQR lives in a subfolder, put the folder in front, for example
# /qr/404.php.
ErrorDocument 404 /404.php

# Force HTTPS. Uncomment these lines once the site has an SSL certificate.
# They are off by default because on a server without SSL they would make the
# site unreachable.
#
# <IfModule mod_rewrite.c>
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>
