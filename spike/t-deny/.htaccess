# Test 5: block direct access to one file, for the configuration file kept in the web root.
# Apache 2.4 and 2.2 use different syntax, so both are given.
<Files "secret.txt">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</Files>